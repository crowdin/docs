---
/**
    Override the default Head component to:
        - Add the `og:image` and `twitter:image` meta tags containing the URL of the generated image for all documentation pages.
        - Add some custom styles (these styles will be applied before the default styles)
        - Set custom site title for the Enterprise and Developer portals
        - Skip the CookieYes consent banner and HelpScout beacon on pages embedded in the application iframe (`embedded`)
*/
import Default from '@astrojs/starlight/components/Head.astro';
import { getCurrentProduct, isStarlightHomepage } from '~/utils/starlightRoute';

const currentProduct = getCurrentProduct(Astro.locals.starlightRoute);

const isHomepage = isStarlightHomepage(Astro.locals.starlightRoute);

const isEnterprise = currentProduct === 'enterprise';
const isDeveloper = currentProduct === 'developer';
const embedded = Astro.locals.starlightRoute.entry?.data?.embedded || false;
const metaRobots = Astro.locals.starlightRoute.entry?.data?.metaRobots || undefined;

const ogImageUrl = new URL(
    `/og/${Astro.locals.starlightRoute.entry.id || 'index'}.png`,
    Astro.site,
);

if (isEnterprise) {
    Astro.locals.starlightRoute.siteTitle = "Enterprise Docs";
}

if (isDeveloper) {
    Astro.locals.starlightRoute.siteTitle = "Developer Portal";
}

if (embedded) {
    Astro.locals.starlightRoute.head = Astro.locals.starlightRoute.head.filter(
        (entry) => entry.attrs?.id !== 'cookieyes',
    );
}
---

<Default><slot /></Default>

<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />
{
    metaRobots &&
        <meta name="robots" content={metaRobots} />
}

{!isHomepage && !embedded && <script src="/src/scripts/helpscout.js" is:inline defer></script>}

<style>
    :root {
        .social-icons a {
            color: var(--sl-color-gray-1);
        }

        select {
            outline: none;
        }
    }
</style>

{isHomepage && (
    <style>
        .content-panel:first-child {
            overflow: hidden;
        }
    </style>
)}

{/* On documentation pages the social icons live in the footer (Footer.astro). */}
{!isHomepage && (
    <style>
        .header .right-group .social-icons {
            display: none;
        }
    </style>
)}
