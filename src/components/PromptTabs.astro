---
import { Icon } from 'astro-icon/components';

export interface Props {
    promptLabel?: string;
    cliLabel?: string;
    promptCopy?: string;
    cliCopy?: string;
}

const {
    promptLabel = Astro.locals.t('promptTabs.prompt'),
    cliLabel = Astro.locals.t('promptTabs.cli'),
    promptCopy,
    cliCopy,
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const tabs = [
    { key: 'prompt', label: promptLabel, icon: 'mdi:auto-awesome', copy: promptCopy },
    { key: 'cli', label: cliLabel, icon: 'mdi:console-line', copy: cliCopy },
];
---

<prompt-tabs class="prompt-tabs">
    <div class="prompt-tabs__header not-content">
        <div role="tablist" aria-orientation="horizontal">
            {tabs.map(({ key, label, icon }, index) => (
                <button
                    type="button"
                    role="tab"
                    id={`prompt-tabs-${uid}-tab-${key}`}
                    aria-controls={`prompt-tabs-${uid}-panel-${key}`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    tabindex={index === 0 ? 0 : -1}
                >
                    <Icon name={icon} class="prompt-tabs__tab-icon" />
                    {label}
                </button>
            ))}
        </div>

        <button
            type="button"
            class="prompt-tabs__copy"
            aria-label={Astro.locals.t('promptTabs.copy')}
            title={Astro.locals.t('promptTabs.copy')}
            data-copy-label={Astro.locals.t('promptTabs.copy')}
            data-copied-label={Astro.locals.t('promptTabs.copied')}
        >
            <Icon name="mdi:content-copy" class="prompt-tabs__copy-icon" />
            <Icon name="mdi:check" class="prompt-tabs__copy-icon prompt-tabs__copy-icon--done" />
        </button>
    </div>

    <div class="prompt-tabs__panels">
        {tabs.map(({ key, copy }, index) => (
            <div
                class="prompt-tabs__panel"
                role="tabpanel"
                id={`prompt-tabs-${uid}-panel-${key}`}
                aria-labelledby={`prompt-tabs-${uid}-tab-${key}`}
                aria-hidden={index === 0 ? 'false' : 'true'}
                data-copy-text={copy}
                inert={index !== 0}
                tabindex="0"
            >
                <slot name={key} />
            </div>
        ))}
    </div>
</prompt-tabs>

<script>
    class PromptTabs extends HTMLElement {
        connectedCallback() {
            const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
            const panels = [...this.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
            const copyButton = this.querySelector<HTMLButtonElement>('.prompt-tabs__copy');

            if (tabs.length === 0 || panels.length !== tabs.length) {
                return;
            }

            const select = (index: number, focusTab = false) => {
                tabs.forEach((tab, i) => {
                    const active = i === index;
                    tab.setAttribute('aria-selected', String(active));
                    tab.tabIndex = active ? 0 : -1;
                    panels[i].setAttribute('aria-hidden', String(!active));
                    panels[i].toggleAttribute('inert', !active);
                });

                if (focusTab) {
                    tabs[index].focus();
                }
            };

            const activeIndex = () => tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');

            tabs.forEach((tab, index) => {
                tab.addEventListener('click', () => select(index));
            });

            this.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
                const { key } = event as KeyboardEvent;
                const current = activeIndex();
                let next = current;

                if (key === 'ArrowRight') next = (current + 1) % tabs.length;
                else if (key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
                else if (key === 'Home') next = 0;
                else if (key === 'End') next = tabs.length - 1;
                else return;

                event.preventDefault();
                select(next, true);
            });

            const textToCopy = (panel: HTMLElement) => {
                const explicit = panel.dataset.copyText?.trim();
                if (explicit) {
                    return explicit;
                }

                // `innerText` keeps the line breaks of a code block, which every
                // line being its own element would otherwise swallow.
                const source = panel.querySelector('pre') ?? panel;

                return (source.innerText || source.textContent || '').trim();
            };

            copyButton?.addEventListener('click', async () => {
                const panel = panels[activeIndex()];
                const copiedLabel = copyButton.getAttribute('data-copied-label') ?? '';
                const copyLabel = copyButton.getAttribute('data-copy-label') ?? '';

                try {
                    await navigator.clipboard.writeText(textToCopy(panel));
                } catch (error) {
                    console.error('Error copying to clipboard:', error);
                    return;
                }

                copyButton.classList.add('prompt-tabs__copy--done');
                copyButton.setAttribute('title', copiedLabel);
                copyButton.setAttribute('aria-label', copiedLabel);

                setTimeout(() => {
                    copyButton.classList.remove('prompt-tabs__copy--done');
                    copyButton.setAttribute('title', copyLabel);
                    copyButton.setAttribute('aria-label', copyLabel);
                }, 2000);
            });
        }
    }

    customElements.define('prompt-tabs', PromptTabs);
</script>

<style>
    .prompt-tabs {
        display: block;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        background: var(--sl-color-bg);
        box-shadow: var(--sl-shadow-sm);
        overflow: hidden;
    }

    .prompt-tabs__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 2.75rem;
        padding-inline: 1rem;
        border-bottom: 1px solid var(--sl-color-gray-5);
        background: var(--sl-color-gray-6);
    }

    [role='tablist'] {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 100%;
        overflow-x: auto;
        scrollbar-width: none;
    }

    [role='tab'] {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        height: 100%;
        padding: 0;
        border: 0;
        border-bottom: 2px solid transparent;
        background: none;
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-xs);
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    [role='tab']:hover,
    [role='tab'][aria-selected='true'] {
        color: var(--sl-color-white);
    }

    [role='tab'][aria-selected='true'] {
        border-bottom-color: var(--sl-color-text-accent);
    }

    .prompt-tabs__tab-icon {
        width: 0.875rem;
        height: 0.875rem;
        color: var(--sl-color-gray-3);
    }

    .prompt-tabs__copy {
        display: inline-flex;
        flex-shrink: 0;
        padding: 0.375rem;
        border: 0;
        border-radius: 0.25rem;
        background: none;
        color: var(--sl-color-gray-3);
        cursor: pointer;
        transition: color 0.2s ease, background 0.2s ease;
    }

    .prompt-tabs__copy:hover {
        background: var(--sl-color-gray-5);
        color: var(--sl-color-white);
    }

    .prompt-tabs__copy-icon {
        width: 0.875rem;
        height: 0.875rem;
    }

    .prompt-tabs__copy-icon--done,
    .prompt-tabs__copy--done .prompt-tabs__copy-icon {
        display: none;
    }

    .prompt-tabs__copy--done .prompt-tabs__copy-icon--done {
        display: inline-flex;
        color: var(--sl-color-text-accent);
    }

    .prompt-tabs__panel {
        padding: 0.875rem 1rem;
        /* A notch below body text, so the widget reads as a control, not as prose. */
        font-size: var(--sl-text-sm);
        line-height: 1.6;
        --ec-codeFontSize: 0.8125rem;
    }

    .prompt-tabs__panel[aria-hidden='true'] {
        display: none;
    }

    .prompt-tabs__panel :global(:first-child) {
        margin-top: 0;
    }

    .prompt-tabs__panel :global(:last-child) {
        margin-bottom: 0;
    }

    /* Our card is the frame, and the header holds the only copy button. */
    .prompt-tabs__panel :global(.expressive-code .frame pre) {
        padding: 0;
        border: 0;
        background: none;
    }

    .prompt-tabs__panel :global(.expressive-code .copy) {
        display: none;
    }
</style>
